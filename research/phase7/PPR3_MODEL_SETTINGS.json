      "family": "SMA 50/200 crossover rule",
      "params": {
        "fast_window": 50,
        "slow_window": 200,
        "signal_states": [
          "FAST_ABOVE_SLOW",
          "FAST_BELOW_SLOW",
          "EQUAL_OR_WARMUP"
        ],
        "probability_mapping": "Laplace-smoothed conditional DOWN/FLAT/UP class rates from training-prefix labels keyed by the persistent current MA state; counts only outcomes whose label endpoints have matured. No validation labels are used to form mapping.",
        "state_rule": "At decision session t, BULLISH/UP state when fast MA[t] > slow MA[t], BEARISH/DOWN state when fast MA[t] < slow MA[t], EQUAL_OR_WARMUP otherwise. A fresh crossover is derivable only from a change in the sign of fast-slow between t-1 and t; it is not the persistent state itself."
      },
      "preprocess": "Use only MAs available by cutoff. Fit initial class mapping on training prefix, then update prequential counts only with labels that mature strictly before each later decision."
