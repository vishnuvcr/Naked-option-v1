{
  "schema_version": 1,
  "protocol_id": "PPR3-v1",
  "status": "PROPOSED_NOT_AUTHORIZED",
  "note": "These settings are the common-project adaptation defaults, not a claim that the source papers used these exact hyperparameters. Any paper-native parameter not verified in PAPER_SOURCE_EVIDENCE_MATRIX.md remains ambiguous; project settings are separately labelled as adaptations.",
  "global_training_rules": {
    "random_seed": 20261010,
    "neural_seeds": [
      20261010,
      20261011,
      20261012
    ],
    "deterministic_algorithms": true,
    "parallel_jobs": 1,
    "training_scaler": "fit on training rows only and reused unchanged on validation rows",
    "regression_target_scaler": "for neural regression only, fit target transform on training rows only and inverse-transform predictions before scoring",
    "categorical_missingness": "do not forward-fill future values; use only prior-as-of observations, with missing indicators when the feature pipeline preregisters them",
    "no_random_time_split": true,
    "sequence_window_sessions": 20,
    "minimum_outer_training_rows": 252,
    "early_stopping": "for neural models only, use the last 10% of the outer training prefix as chronological inner validation; patience 10; this subset never includes outer validation rows",
    "neural_max_epochs": 100,
    "neural_batch_size": 32,
    "neural_optimizer": "Adam",
    "neural_learning_rate": 0.001
  },
  "feature_pipeline_definitions": {
    "CORE_OHLCV_TECH": {
      "definition": "NIFTY daily OHLCV lag features and causal technical features; always computed as-of the decision cutoff.",
      "fixed_fields": [
        "open_lag_1",
        "high_lag_1",
        "low_lag_1",
        "close_lag_1",
        "volume_lag_1",
        "close_return_lags_1_2_3_5_10",
        "high_low_range_lag_1",
        "sma_10",
        "sma_20",
        "rsi_14",
        "rolling_return_sd_20"
      ],
      "availability": "daily close-derived fields only after the official close is published; pre-close rows use the prior completed session",
      "transform": "scalers fitted on training only; warm-up/missing rows removed without future fill"
    },
    "EXTERNAL_MARKET": {
      "definition": "CORE_OHLCV_TECH plus externally traded market/macro features whose values were available by the NIFTY decision timestamp.",
      "candidate_fields": [
        "SENSEX returns",
        "Bank Nifty returns",
        "S&P 500 returns",
        "Nasdaq returns",
        "Nikkei/Hang Seng returns",
        "USD/INR",
        "gold",
        "crude oil",
        "Cboe VIX",
        "US rates where published"
      ],
      "availability": "as-of joins use provider observation and availability timestamps; daily closes default to the next Indian session unless exact publication timing is verified",
      "source_rule": "PPR-4 must freeze actual series symbols, source hashes, field availability, units and history coverage; absent/unverified data mark affected variants BLOCKED_DATA"
    },
    "FLOWS_OPTIONS": {
      "definition": "CORE_OHLCV_TECH plus timestamp-valid FII/FPI/DII activity, India VIX and option-context features where a genuine point-in-time snapshot exists.",
      "candidate_fields": [
        "FII/FPI/DII flow or gross buy/sell features",
        "India VIX",
        "contract OI and OI change",
        "put-call OI/volume measures",
        "IV/skew/Greeks when point-in-time snapshots are verified"
      ],
      "availability": "use report publication/availability timestamps and exact contract snapshots; no retrospective EOD option chain can be joined to a pre-snapshot decision",
      "source_rule": "PPR-4 must verify official or free-source availability, coverage and canonical schema; the one-use Dhan sample approval remains spent"
    },
    "TIMESTAMPED_SENTIMENT_FUSION": {
      "definition": "CORE_OHLCV_TECH plus time-valid historical text sentiment, with source-specific context fields only if those fields independently pass the point-in-time gate.",
      "candidate_fields": [
        "timestamp-valid historical news sentiment",
        "timestamp-valid historical tweet mood/sentiment",
        "sentiment volume/count and three-session lag features where the source method calls for them",
        "FII/DII/VIX/PCR context only when the specific source configuration includes them and availability is verified"
      ],
      "news_rule": "original publication timestamp and ingestion timestamp must both precede decision cutoff; date-only same-day items are excluded unless a predeclared lag makes availability unambiguous",
      "model_rule": "any pretrained text model must be chosen before data inspection, revision/hash-pinned and cached; no BERT/FinBERT inference or download is authorized by this settings file",
      "source_rule": "PPR-4 must record free-source search, licenses/terms, timestamp coverage and archive hashes; no substitute current headlines"
    }
  },
  "templates": {
    "LOGISTIC_CLASSIFIER": {
      "family": "sklearn LogisticRegression",
      "params": {
        "C": 1,
        "penalty": "l2",
        "solver": "lbfgs",
        "max_iter": 2000,
        "class_weight": null
      },
      "preprocess": "standardize inputs using training prefix; output calibrated predict_proba in DOWN,FLAT,UP order"
    },
    "KNN_CLASSIFIER": {
      "family": "sklearn KNeighborsClassifier",
